# Upstash Redis (console.upstash.com -> your database -> REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel AI Gateway, used to reach TypeSafe AI's Jev
AI_GATEWAY_API_KEY=

# X API v2, read-only app token (console.x.com)
X_BEARER_TOKEN=

# Optional: when set, /api/ingest also requires `Authorization: Bearer <value>`
INGEST_SECRET=
